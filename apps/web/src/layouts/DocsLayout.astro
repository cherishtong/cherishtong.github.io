---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocsSidebar from '@/components/docs/DocsSidebar.astro';

interface DocItem {
  id: string;
  title: string;
  section: string;
  order: number;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  currentId: string;
  docs: DocItem[];
}

const { title, description = '', headings, currentId, docs } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={`${title} · 文档 · 赵无为`} description={description || '赵无为的配置文档'}>
  <section class="section">
    <div class="docs-shell container">
      <DocsSidebar docs={docs} currentId={currentId} />

      <div class="docs-main">
        <details class="docs-mobile-nav">
          <summary>文档目录</summary>
          <div class="docs-mobile-links">
            {docs.map((doc) => (
              <a
                href={`/docs/${doc.id}/`}
                class:list={[{ active: doc.id === currentId }]}
                aria-current={doc.id === currentId ? 'page' : undefined}
              >
                {doc.title}
              </a>
            ))}
          </div>
        </details>

        <article class="prose">
          <div class="eyebrow">文档 / DOCS</div>
          <h1>{title}</h1>
          {description && <p class="docs-description">{description}</p>}
          <slot />
        </article>
      </div>

      <aside class="docs-toc" aria-label="本页目录">
        <div class="sidebar-label">本页目录</div>
        {toc.map((heading) => (
          <a href={`#${heading.slug}`} class:list={[`depth-${heading.depth}`]}>
            {heading.text}
          </a>
        ))}
      </aside>
    </div>
  </section>
</BaseLayout>
