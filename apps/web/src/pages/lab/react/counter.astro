---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Counter from '@/components/lab/react/Counter.tsx';
---

<BaseLayout
  title="React Counter · Lab · 赵无为"
  description="React 19 的 useState 计数器，使用 client:visible 按需水合。"
>
  <section class="section container">
    <div class="section-head">
      <div class="eyebrow">LAB / REACT</div>
      <h2>React Counter</h2>
      <p>
        React 组件先由 Astro 做 SSR，进入视口后再用 <code>client:visible</code>
        水合。计数器初始状态在服务端和客户端都是 0。
      </p>
    </div>

    <div class="card">
      <Counter client:visible />
    </div>

    <div class="demo-label">USAGE</div>
    <div class="code-block">
      <div class="code-head">
        <span>src/pages/lab/react/counter.astro</span>
      </div>
      <pre><code><span class="tok-keyword">import</span> Counter <span class="tok-keyword">from</span> <span class="tok-string">'@/components/lab/react/Counter.tsx'</span>;

&lt;<span class="tok-fn">Counter</span> client:visible /&gt;</code></pre>
    </div>

    <p style="margin-top: 2rem;">
      <a class="prose-link" href="/lab">
        ← 回到实验室
      </a>
    </p>
  </section>
</BaseLayout>
