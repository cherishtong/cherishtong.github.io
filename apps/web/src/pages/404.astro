---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 墨纸山河" description="这一页不存在。" noindex>
  <section class="section container">
    <div class="section-head">
      <div class="eyebrow">404 / NOT FOUND</div>
      <h2>此路不通</h2>
      <p>你要找的页面可能被移走了，或者从来就没有存在过。</p>
    </div>

    <div class="actions">
      <a class="btn btn-vermilion" href="/">
        回到首页
      </a>
      <a class="btn btn-ghost" href="/styleguide">
        看看风格指南
      </a>
    </div>
  </section>
</BaseLayout>
