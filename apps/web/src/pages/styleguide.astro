---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="风格指南 · 墨纸山河"
  description="墨纸山河的设计语言：故宫色谱、书法、卡片、导航、文章排版与表单。"
>
  <!-- Hero -->
  <section class="hero container" id="top">
    <div class="hero-inscription" aria-hidden="true">
      <span class="vertical-text">山河入卷</span>
      <span class="seal">墨</span>
    </div>

    <div class="eyebrow">主题测试 / 2026</div>
    <h1>墨纸朱砂</h1>
    <p class="subtitle">Ink &amp; Vermilion — a quiet interface for loud ideas.</p>
    <p class="lede">
      以中国传统文房美学为源：墨色为骨，宣纸为底，宫墙红为气口。背景是一幅固定的山水——
      群山连绵，长城蜿蜒，六十四卦隐于天际。用衬线标题、宋体正文和一点点终端气质，
      构成一个适合长文阅读、项目展示与框架实验的个人站主题。
    </p>

    <div class="actions">
      <a class="btn btn-vermilion" href="#colors">
        查看设计令牌
      </a>
      <a class="btn btn-ghost" href="#prose">
        阅读示例文章
      </a>
    </div>

    <div class="terminal-line">
      <span class="prompt">~/theme-test</span>
      <span class="cmd">$</span>
      cat tokens.css
      <span class="cursor"></span>
    </div>
  </section>

  <!-- Colors -->
  <section class="section container" id="colors">
    <div class="section-head">
      <div class="eyebrow">壹 / COLORS</div>
      <h2>色彩令牌</h2>
      <p>以故宫色谱为骨：宫墙红、鎏金、石青、石绿与宣纸。80% 纸色，15% 墨色，5% 朱砂与金。</p>
    </div>

    <div class="demo-label">BRAND / 主色</div>
    <div class="swatch-grid">
      <div class="swatch">
        <div class="swatch-color" style="background: #211e1a;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">ink 墨色</p>
          <p class="swatch-hex">#211e1a</p>
          <p class="swatch-token">bg-ink / text-ink</p>
        </div>
      </div>

      <div class="swatch">
        <div class="swatch-color swatch-paper" style="background: #f3ede1;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">paper 宣纸</p>
          <p class="swatch-hex">#f3ede1</p>
          <p class="swatch-token">bg-paper</p>
        </div>
      </div>

      <div class="swatch">
        <div class="swatch-color" style="background: #8c1f28;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">vermilion 宫墙红</p>
          <p class="swatch-hex">#8c1f28</p>
          <p class="swatch-token">text-vermilion / bg-vermilion</p>
        </div>
      </div>

      <div class="swatch">
        <div class="swatch-color" style="background: #171411;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">matrix 玄墨</p>
          <p class="swatch-hex">#171411</p>
          <p class="swatch-token">bg-matrix</p>
        </div>
      </div>
    </div>

    <div class="demo-label">ACCENT / 故宫辅助色</div>
    <div class="swatch-grid">
      <div class="swatch">
        <div class="swatch-color" style="background: #b08d57;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">gold 鎏金</p>
          <p class="swatch-hex">#b08d57</p>
          <p class="swatch-token">gold / 边线与印章</p>
        </div>
      </div>

      <div class="swatch">
        <div class="swatch-color" style="background: #2f5d62;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">stone-blue 石青</p>
          <p class="swatch-hex">#2f5d62</p>
          <p class="swatch-token">stone-blue / 链接与信息</p>
        </div>
      </div>

      <div class="swatch">
        <div class="swatch-color" style="background: #4f6b57;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">stone-green 石绿</p>
          <p class="swatch-hex">#4f6b57</p>
          <p class="swatch-token">stone-green / 成功</p>
        </div>
      </div>

      <div class="swatch">
        <div class="swatch-color" style="background: #b8862b;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">amber 琉璃黄</p>
          <p class="swatch-hex">#b8862b</p>
          <p class="swatch-token">amber / 提醒</p>
        </div>
      </div>
    </div>

    <div class="demo-label">SEMANTIC / 语义色</div>
    <div class="swatch-grid">
      <div class="swatch">
        <div class="swatch-color" style="background: #4f6b57;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">success</p>
          <p class="swatch-hex">#4f6b57</p>
          <p class="swatch-token">石绿</p>
        </div>
      </div>

      <div class="swatch">
        <div class="swatch-color" style="background: #b8862b;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">warning</p>
          <p class="swatch-hex">#b8862b</p>
          <p class="swatch-token">琉璃黄</p>
        </div>
      </div>

      <div class="swatch">
        <div class="swatch-color" style="background: #8c1f28;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">error</p>
          <p class="swatch-hex">#8c1f28</p>
          <p class="swatch-token">宫墙红</p>
        </div>
      </div>

      <div class="swatch">
        <div class="swatch-color" style="background: #2f5d62;"></div>
        <div class="swatch-meta">
          <p class="swatch-name">info</p>
          <p class="swatch-hex">#2f5d62</p>
          <p class="swatch-token">石青</p>
        </div>
      </div>
    </div>

    <div class="demo-label">NEUTRAL / 暖灰</div>
    <div class="neutral-row">
      <div class="neutral-chip" style="background: #fbf7ef;" title="50"></div>
      <div class="neutral-chip" style="background: #f3ede1;" title="100"></div>
      <div class="neutral-chip" style="background: #e8dfd0;" title="200"></div>
      <div class="neutral-chip" style="background: #d8ccb9;" title="300"></div>
      <div class="neutral-chip" style="background: #b5a996;" title="400"></div>
      <div class="neutral-chip" style="background: #8c8171;" title="500"></div>
      <div class="neutral-chip" style="background: #6e675c;" title="600"></div>
      <div class="neutral-chip" style="background: #514b42;" title="700"></div>
      <div class="neutral-chip" style="background: #3a352e;" title="800"></div>
      <div class="neutral-chip" style="background: #211e1a;" title="900"></div>
    </div>
    <p class="neutral-caption">
      50 #fbf7ef · 100 #f3ede1 · 200 #e8dfd0 · 300 #d8ccb9 · 400 #b5a996 · 500 #8c8171 · 600 #6e675c
      · 700 #514b42 · 800 #3a352e · 900 #211e1a
    </p>
  </section>

  <!-- Typography -->
  <section class="section container" id="type">
    <div class="section-head">
      <div class="eyebrow">贰 / TYPOGRAPHY</div>
      <h2>字体与排版</h2>
      <p>衬线标题负责气质，宋体正文负责阅读，书法体只做题字，等宽字体负责技术感。</p>
    </div>

    <div class="type-list">
      <div class="type-row">
        <div class="type-label">Display / Serif / 64</div>
        <div class="type-display">道常无为而无不为</div>
      </div>

      <div class="type-row">
        <div class="type-label">Calligraphy / 书法</div>
        <div class="type-calligraphy">笔墨千秋</div>
      </div>

      <div class="type-row">
        <div class="type-label">H2 / Serif / 24</div>
        <div class="type-h2">设计理念：留白与克制</div>
      </div>

      <div class="type-row">
        <div class="type-label">H3 / Serif / 18</div>
        <div class="type-h3">墨色为骨，纸张为底</div>
      </div>

      <div class="type-row">
        <div class="type-label">Body / Sans / 16</div>
        <div class="type-body">
          以中国传统文房美学为源，墨色为骨、纸张为底、朱砂为血。界面文字保持 1.8
          左右的行高，长文阅读时不会显得拥挤。
        </div>
      </div>

      <div class="type-row">
        <div class="type-label">Prose / Serif / 17</div>
        <div class="type-serif">
          以中国传统文房美学为源，墨色为骨、纸张为底、朱砂为血。长文阅读时，
          宋体的横细竖粗会让页面更像一本书。
        </div>
      </div>

      <div class="type-row">
        <div class="type-label">Small / Sans / 14</div>
        <div class="type-small">覆盖博客、文档、项目与实验室。</div>
      </div>

      <div class="type-row">
        <div class="type-label">Micro / Mono / 10.4</div>
        <div class="type-micro">Design Tokens / 2026</div>
      </div>

      <div class="type-row">
        <div class="type-label">Mono / 13</div>
        <div class="type-mono">const theme = 'ink-and-vermilion';</div>
      </div>

      <div class="type-row">
        <div class="type-label">Quote / Serif / 18</div>
        <div>
          <blockquote>
            「道常无为而无不为。」
            <cite>—《道德经》第三十七章</cite>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- Components -->
  <section class="section container" id="components">
    <div class="section-head">
      <div class="eyebrow">叁 / COMPONENTS</div>
      <h2>组件配方</h2>
      <p>按钮、卡片、导航、表单。所有组件都在同一套 token 上生长。</p>
    </div>

    <div class="demo-label">BUTTONS / VARIANTS</div>
    <div class="button-row">
      <button class="btn btn-primary" type="button">
        Primary Ink
      </button>
      <button class="btn btn-vermilion" type="button">
        Vermilion
      </button>
      <button class="btn btn-ghost" type="button">
        Ghost
      </button>
      <button class="btn btn-gradient" type="button">
        Gradient
      </button>
      <button class="btn btn-text-gradient" type="button">
        Text Link
      </button>
    </div>

    <div class="demo-label">BUTTONS / SIZES</div>
    <div class="button-row">
      <button class="btn btn-primary btn-sm" type="button">
        Small
      </button>
      <button class="btn btn-primary" type="button">
        Default
      </button>
      <button class="btn btn-primary btn-lg" type="button">
        Large
      </button>
      <button class="btn btn-vermilion btn-pill" type="button">
        Pill Button
      </button>
      <button class="btn btn-primary" type="button" disabled>
        Disabled
      </button>
    </div>

    <div class="demo-label">CARDS</div>
    <div class="card-grid">
      <div class="card">
        <div class="card-label">DEFAULT</div>
        <h3 class="card-title">纸上博客</h3>
        <p class="card-text">适合长文阅读的排版，68ch 正文宽度，衬线标题与克制的灰阶。</p>
      </div>

      <div class="card card-ru">
        <div class="card-label">FEATURED</div>
        <h3 class="card-title">Ru / 墨色渐变</h3>
        <p class="card-text">精选项目、年度总结，或需要被一眼看到的入口。</p>
      </div>
    </div>

    <div class="demo-label">GLASS</div>
    <div class="glass-stage">
      <div class="glass glass-light">
        <div class="card-label">GLASS / LIGHT</div>
        <h3 class="card-title">液态玻璃</h3>
        <p class="card-text">半透明、毛玻璃、顶部高光线。只用在少量重点卡片上，不要全站铺开。</p>
      </div>
    </div>

    <div class="glass-stage dark-stage">
      <div class="glass glass-dark">
        <div class="card-label">GLASS / DARK</div>
        <h3 class="card-title">矩阵黑玻璃</h3>
        <p class="card-text">适合深色区块、项目封面或 Lab 的重点演示。</p>
      </div>
    </div>
  </section>

  <!-- Navigation -->
  <section class="section container" id="navigation">
    <div class="section-head">
      <div class="eyebrow">肆 / NAVIGATION</div>
      <h2>导航与状态</h2>
      <p>顶部导航、文档侧边栏、面包屑、标签与命令面板。</p>
    </div>

    <div class="nav-demo">
      <div class="nav-demo-top">
        <div class="brand">
          <span class="brand-name">墨纸</span>
          <span class="brand-sub">Ink &amp; Vermilion</span>
        </div>
        <nav class="nav" aria-label="演示导航">
          <a href="#colors" class="active">
            <span class="prompt">~/</span>blog
          </a>
          <a href="#type">
            <span class="prompt">~/</span>docs
          </a>
          <a href="#components">
            <span class="prompt">~/</span>projects
          </a>
          <a href="#prose">
            <span class="prompt">~/</span>lab
          </a>
        </nav>
        <span class="theme-toggle">
          <span class="toggle-dot"></span>DARK
        </span>
      </div>

      <div class="sidebar-demo">
        <aside class="sidebar" aria-label="文档侧边栏演示">
          <div class="sidebar-group">
            <div class="sidebar-label">概述</div>
            <a class="sidebar-link" href="#colors">
              简介
            </a>
            <a class="sidebar-link" href="#type">
              快速开始
            </a>
          </div>

          <div class="sidebar-group">
            <div class="sidebar-label">设计令牌</div>
            <a class="sidebar-link active" href="#colors">
              色彩 · 字体 · 间距
            </a>
          </div>

          <div class="sidebar-group">
            <div class="sidebar-label">基础组件</div>
            <a class="sidebar-link" href="#components">
              按钮 Button
            </a>
            <a class="sidebar-link" href="#components">
              卡片 Card
            </a>
            <a class="sidebar-link" href="#components">
              玻璃卡 GlassCard
            </a>
          </div>
        </aside>

        <div class="sidebar-content">
          <div class="breadcrumb">
            <span class="prompt">~/</span>docs<span class="sep">/</span>dotfiles
            <span class="sep">/</span>
            <span class="current">shell</span>
          </div>

          <div class="tag-row">
            <span class="tag">astro</span>
            <span class="tag">tailwind</span>
            <span class="tag">design-system</span>
            <span class="tag">math</span>
          </div>

          <div class="tabs" role="tablist" aria-label="内容切换演示">
            <button class="tab active" type="button" role="tab" aria-selected="true">
              预览
            </button>
            <button class="tab" type="button" role="tab" aria-selected="false">
              代码
            </button>
            <button class="tab" type="button" role="tab" aria-selected="false">
              API
            </button>
          </div>

          <p class="type-body" style="margin-top: 1rem;">
            侧边栏使用 260px 固定宽度，活跃项以朱砂色左边框标记；正文区域保持 56rem
            的最大宽度，和博客详情共用同一套阅读节奏。
          </p>
        </div>
      </div>
    </div>

    <div class="demo-label">COMMAND PALETTE</div>
    <div class="command">
      <div class="command-input">
        <span class="prompt">&gt;</span>
        search posts, docs, projects...
        <span class="cursor"></span>
      </div>
      <div class="command-results">
        <div class="command-item active">
          <span>~/blog/astro-7-rebuild</span>
          <span class="hint">POST</span>
        </div>
        <div class="command-item">
          <span>~/docs/dotfiles/shell</span>
          <span class="hint">DOC</span>
        </div>
        <div class="command-item">
          <span>~/lab/react/counter</span>
          <span class="hint">LAB</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Prose -->
  <section class="section container" id="prose">
    <div class="section-head">
      <div class="eyebrow">伍 / PROSE</div>
      <h2>文章排版</h2>
      <p>这是博客详情的阅读效果。正文 68ch，宋体，行高 1.95，标题用衬线。</p>
    </div>

    <article class="prose">
      <div class="eyebrow">NOTE / 2026-10-18</div>
      <h1>在纸上写代码</h1>
      <p class="article-meta">8 min read · #astro #design #math</p>

      <p class="lead">
        重构个人站的第一天，我决定把原来的 dashboard 拆掉。不是因为它不好看，而是因为它
        不像一个可以长期写字的地方。个人站首先应该是一张纸，其次才是一个作品集。
      </p>

      <p>
        这套主题叫<strong>墨纸朱砂</strong>：宣纸是底，墨色是字，宫墙红与鎏金是气口。 它参考了{' '}
        <a href="#colors">无为设计系统</a> 的文房气质，又把故宫色谱里的石青、
        石绿收进链接与状态色里，让页面稳重，但不沉闷。
      </p>

      <h2>墨色与朱砂</h2>

      <p>
        颜色不需要很多。一个页面里，宫墙红出现的地方越少，它就越有力。标题前的短线、
        活跃导航、引用块的左边框、主按钮，这些位置已经足够；鎏金只负责边线和印章，
        石青与石绿负责链接和状态。
      </p>

      <blockquote>
        「道常无为而无不为。」
        <cite>—《道德经》第三十七章</cite>
      </blockquote>

      <p>
        正文使用宋体，保持 17px / 1.95 的阅读节奏；标题使用更重的衬线，负责气质和层级。
        代码、日期、标签则使用等宽字体，提醒读者这是一个技术站。
      </p>

      <h3>代码块</h3>

      <div class="code-block">
        <div class="code-head">
          <div class="code-dots">
            <span class="code-dot"></span>
            <span class="code-dot"></span>
            <span class="code-dot"></span>
          </div>
          <span>src/lib/theme.ts</span>
          <button class="code-copy" data-copy="#code-theme" type="button">
            复制
          </button>
        </div>
        <pre id="code-theme"><code><span class="tok-comment">// 墨纸朱砂</span>
<span class="tok-keyword">const</span> theme = &#123;
  paper: <span class="tok-string">'#f3ede1'</span>,
  ink: <span class="tok-string">'#211e1a'</span>,
  vermilion: <span class="tok-string">'#8c1f28'</span>,
  matrix: <span class="tok-string">'#171411'</span>,
&#125;;

<span class="tok-keyword">export</span> <span class="tok-keyword">default</span> theme;</code></pre>
      </div>

      <h3>表格</h3>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Token</th>
              <th>值</th>
              <th>用途</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>paper</td>
              <td class="mono">#f3ede1</td>
              <td>宣纸底色</td>
            </tr>
            <tr>
              <td>ink</td>
              <td class="mono">#211e1a</td>
              <td>正文与标题</td>
            </tr>
            <tr>
              <td>vermilion</td>
              <td class="mono">#8c1f28</td>
              <td>宫墙红，强调与活跃状态</td>
            </tr>
            <tr>
              <td>matrix</td>
              <td class="mono">#171411</td>
              <td>玄墨，深色区块与代码</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3>提示</h3>

      <div class="alert alert-info">
        <span class="alert-icon">i</span>
        <div>
          <strong>提示：</strong>朱砂只做强调，不铺大面积。
        </div>
      </div>

      <div class="alert alert-warning">
        <span class="alert-icon">!</span>
        <div>
          <strong>注意：</strong>亮色模式下，正文与背景的对比度要保持在 4.5:1 以上。
        </div>
      </div>

      <h3>数学公式</h3>

      <p>
        行内公式：<span class="math-inline" data-math="E = mc^2" data-display="false"></span>
        ，以及一个定积分：
      </p>

      <div
        class="math-display"
        data-math="\int_&#123;-\infty&#125;^&#123;\infty&#125; e^&#123;-x^2&#125;\,dx = \sqrt&#123;\pi&#125;"
        data-display="true"
      ></div>

      <p>正式站会在构建时用 Sätteri + KaTeX 渲染，不引入客户端 MathJax 运行时。</p>
    </article>
  </section>

  <!-- Forms -->
  <section class="section container" id="forms">
    <div class="section-head">
      <div class="eyebrow">陆 / FORMS</div>
      <h2>表单元素</h2>
      <p>输入框、选择器、开关。聚焦状态使用朱砂色细环。</p>
    </div>

    <div class="form-grid">
      <div class="field">
        <label class="field-label" for="theme-name">
          名称
        </label>
        <input class="input" id="theme-name" type="text" placeholder="输入你的名字" />
      </div>

      <div class="field">
        <label class="field-label" for="theme-topic">
          主题
        </label>
        <select class="select" id="theme-topic">
          <option>Astro</option>
          <option>React</option>
          <option>Vue</option>
          <option>Svelte</option>
        </select>
      </div>

      <div class="field" style="grid-column: 1 / -1;">
        <label class="field-label" for="theme-message">
          留言
        </label>
        <textarea class="textarea" id="theme-message" placeholder="写点什么..."></textarea>
      </div>

      <div class="field field-error">
        <label class="field-label" for="theme-email">
          邮箱
        </label>
        <input
          class="input"
          id="theme-email"
          type="email"
          value="not-an-email"
          aria-invalid="true"
        />
        <span class="error-text">请输入有效的邮箱地址</span>
      </div>

      <div class="field">
        <span class="field-label">偏好</span>
        <label class="check-row">
          <input type="checkbox" checked />
          接收新文章通知
        </label>
        <label class="check-row">
          <input type="radio" name="theme-mode" checked />
          亮色模式
        </label>
        <label class="check-row">
          <input type="radio" name="theme-mode" />
          暗色模式
        </label>
      </div>

      <div class="field">
        <span class="field-label">开关</span>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <button
            class="switch on"
            data-switch
            type="button"
            aria-pressed="true"
            aria-label="切换终端点缀"
          ></button>
          <span class="type-small">启用终端点缀</span>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      document.querySelectorAll('.tabs').forEach((group) => {
        const tabs = group.querySelectorAll('.tab');
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            tabs.forEach((item) => {
              item.classList.remove('active');
              item.setAttribute('aria-selected', 'false');
            });
            tab.classList.add('active');
            tab.setAttribute('aria-selected', 'true');
          });
        });
      });

      document.querySelectorAll('[data-switch]').forEach((sw) => {
        sw.addEventListener('click', () => {
          sw.classList.toggle('on');
          sw.setAttribute('aria-pressed', sw.classList.contains('on') ? 'true' : 'false');
        });
      });

      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const target = document.querySelector(button.dataset.copy);
          if (!target) return;
          const original = button.textContent;
          try {
            await navigator.clipboard.writeText(target.innerText);
            button.textContent = '已复制';
          } catch {
            button.textContent = '复制失败';
          }
          window.setTimeout(() => {
            button.textContent = original;
          }, 1500);
        });
      });
    })();
  </script>
  <script>
    import katex from 'katex';

    document.querySelectorAll<HTMLElement>('[data-math]').forEach((el) => {
      katex.render(el.dataset.math ?? '', el, {
        displayMode: el.dataset.display === 'true',
        throwOnError: false,
      });
    });
  </script>
</BaseLayout>
