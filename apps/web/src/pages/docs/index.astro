---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const docs = (await getCollection('docs', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const grouped = docs.reduce<Record<string, typeof docs>>((groups, doc) => {
  (groups[doc.data.section] ??= []).push(doc);
  return groups;
}, {});
---

<BaseLayout title="文档 · 墨纸山河" description="dotfiles、终端、编辑器，以及那些值得记下来的坑。">
  <section class="section container">
    <div class="section-head">
      <div class="eyebrow">贰 / DOCS</div>
      <h2>配置与工具</h2>
      <p>dotfiles、终端、编辑器，以及那些值得记下来的坑。</p>
    </div>

    {Object.entries(grouped).map(([section, items]) => (
      <div class="docs-index-group">
        <h3>{section}</h3>
        <div class="card-grid">
          {items.map((doc) => (
            <a class="card" href={`/docs/${doc.id}/`}>
              <div class="card-label">DOC / {String(doc.data.order).padStart(2, '0')}</div>
              <h3 class="card-title">{doc.data.title}</h3>
              {doc.data.description && <p class="card-text">{doc.data.description}</p>}
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
