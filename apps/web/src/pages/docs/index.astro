---
import { getCollection } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { sortDocs } from '@/lib/docs';

const docs = sortDocs(
  await getCollection('docs', ({ data }) => import.meta.env.DEV || !data.draft),
);

const docItems = docs.map((doc) => ({
  id: doc.id,
  title: doc.data.title,
  category: doc.data.category,
  group: doc.data.group,
  order: doc.data.order,
}));

const categories = new Map<string, { count: number; firstId: string; description?: string }>();

for (const doc of docs) {
  const existing = categories.get(doc.data.category);
  if (existing) {
    existing.count += 1;
  } else {
    categories.set(doc.data.category, {
      count: 1,
      firstId: doc.id,
      description: doc.data.description,
    });
  }
}
---

<DocsLayout
  title="文档"
  description="个人全局配置、学习、软件与兴趣。左侧菜单可以收起，每个分类也可以展开或折叠。"
  headings={[]}
  currentId=""
  docs={docItems}
>
  <div class="docs-home">
    <p>
      这里放长期维护的文档。目前先整理个人全局配置，之后会加入学习、软件、兴趣等分类。
      左侧菜单可以整体收起，也可以把每个分类折叠起来。
    </p>

    <div class="docs-home-grid">
      {[...categories.entries()].map(([category, meta]) => (
        <a class="card" href={`/docs/${meta.firstId}/`}>
          <div class="card-label">{meta.count} 篇文档</div>
          <div class="card-title">{category}</div>
          <div class="card-text">{meta.description ?? '这个分类正在整理。'}</div>
        </a>
      ))}
    </div>
  </div>
</DocsLayout>
