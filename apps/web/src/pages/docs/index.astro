---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sortDocs } from '@/lib/docs';

const docs = sortDocs(
  await getCollection('docs', ({ data }) => import.meta.env.DEV || !data.draft),
);

const grouped = docs.reduce<Record<string, typeof docs>>((groups, doc) => {
  (groups[doc.data.section] ??= []).push(doc);
  return groups;
}, {});
---

<BaseLayout
  title="文档 · 赵无为"
  description="赵无为的跨平台 dotfiles：终端、Shell、tmux、编辑器与 OpenCode。"
>
  <section class="section container">
    <div class="section-head">
      <div class="eyebrow">贰 / DOCS</div>
      <h2>赵无为配置文档</h2>
      <p>赵无为的跨平台 dotfiles：终端、Shell、tmux、编辑器与 OpenCode。</p>
    </div>

    {Object.entries(grouped).map(([section, items]) => (
      <div class="docs-index-group">
        <h3>{section}</h3>
        <div class="card-grid">
          {items.map((doc) => (
            <a class="card" href={`/docs/${doc.id}/`}>
              <div class="card-label">DOC / {String(doc.data.order).padStart(2, '0')}</div>
              <h3 class="card-title">{doc.data.title}</h3>
              {doc.data.description && <p class="card-text">{doc.data.description}</p>}
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
