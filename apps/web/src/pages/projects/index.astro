---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const projects = (
  await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.title.localeCompare(b.data.title, 'zh-CN');
});
---

<BaseLayout title="项目 · 墨纸山河" description="做过的、正在做的，以及一些可以点开看看的东西。">
  <section class="section container">
    <div class="section-head">
      <div class="eyebrow">叁 / PROJECTS</div>
      <h2>项目与演示</h2>
      <p>做过的、正在做的，以及一些可以点开看看的东西。</p>
    </div>

    <div class="card-grid">
      {projects.map((project) => (
        <a
          class:list={['card', { 'card-ru': project.data.featured }]}
          href={`/projects/${project.id}/`}
        >
          <div class="card-label">
            {project.data.period ?? 'PROJECT'} / {project.data.status.toUpperCase()}
          </div>
          <h3 class="card-title">{project.data.title}</h3>
          <p class="card-text">{project.data.summary}</p>
          {project.data.stack.length > 0 && (
            <div class="tag-row" style="margin-top: 1rem; margin-bottom: 0;">
              {project.data.stack.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
