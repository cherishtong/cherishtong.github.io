---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Taiji from '@/components/site/Taiji.astro';
---

<BaseLayout
  title="赵无为 · 个人网站"
  description="赵无为的个人网站：读诸子百家，尤好庄子；写代码，也写山水。"
>
  <section class="hero container">
    <Taiji class="hero-taiji" />

    <div class="hero-inscription" aria-hidden="true">
      <span class="vertical-text">山河入卷</span>
      <span class="seal">墨</span>
    </div>

    <div class="eyebrow">诸子百家 / 读庄</div>
    <h1>赵无为</h1>
    <p class="subtitle">墨纸山河 — 乘物以游心，托不得已以养中。</p>
    <p class="lede">
      喜欢诸子百家，尤其庄子。这里放长文、文档、项目演示和前端框架实验；
      背景是一幅固定的山水，文字写在宣纸与墨色之间，偶尔停下来读一段庄周。
    </p>

    <div class="actions">
      <a class="btn btn-vermilion" href="/blog">
        进入博客
      </a>
      <a class="btn btn-ghost" href="/projects">
        查看项目
      </a>
    </div>

    <div class="terminal-line">
      <span class="prompt">~/home</span>
      <span class="cmd">$</span>
      ls ./sections
      <span class="cursor"></span>
    </div>
  </section>

  <section class="section container">
    <div class="eyebrow">读庄 / ZHUANGZI</div>
    <figure class="quote-band">
      <span class="seal quote-seal" aria-hidden="true">
        庄
      </span>
      <blockquote>
        「天地有大美而不言，四时有明法而不议，万物有成理而不说。」
        <cite>—《庄子·知北游》</cite>
      </blockquote>
    </figure>
  </section>

  <section class="section container">
    <div class="section-head">
      <div class="eyebrow">壹 / SECTIONS</div>
      <h2>四个入口</h2>
      <p>写下来的、整理过的、做出来的、正在练习的，各有一处。</p>
    </div>

    <div class="card-grid">
      <a class="card" href="/blog">
        <div class="card-label">01 / BLOG</div>
        <h3 class="card-title">在纸上写字</h3>
        <p class="card-text">长文、笔记、复盘，以及偶尔的技术随笔。</p>
      </a>

      <a class="card" href="/docs">
        <div class="card-label">02 / DOCS</div>
        <h3 class="card-title">配置文档</h3>
        <p class="card-text">赵无为的 dotfiles：终端、Shell、tmux、编辑器与 OpenCode。</p>
      </a>

      <a class="card" href="/projects">
        <div class="card-label">03 / PROJECTS</div>
        <h3 class="card-title">项目与演示</h3>
        <p class="card-text">做过的、正在做的，以及一些可以点开看看的东西。</p>
      </a>

      <a class="card" href="/lab">
        <div class="card-label">04 / LAB</div>
        <h3 class="card-title">框架实验室</h3>
        <p class="card-text">React、Vue 与其他前端框架的示例和对比。</p>
      </a>
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <div class="eyebrow">贰 / ABOUT</div>
      <h2>关于赵无为</h2>
      <p>读诸子百家，尤好庄子；写代码，也写山水。</p>
    </div>

    <a class="btn btn-ghost" href="/about">
      关于这个站
    </a>
  </section>
</BaseLayout>
