---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['taiji', className]} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="3"></circle>
  <path
    d="M50 3a47 47 0 0 1 0 94 23.5 23.5 0 0 1 0-47 23.5 23.5 0 0 0 0-47Z"
    fill="currentColor"
  ></path>
  <circle cx="50" cy="26.5" r="5.875" fill="var(--paper)"></circle>
  <circle cx="50" cy="73.5" r="5.875" fill="currentColor"></circle>
</svg>

<style>
  .taiji {
    width: 1em;
    height: 1em;
  }
</style>
