---
interface DocItem {
  id: string;
  title: string;
  category: string;
  group: string;
  order: number;
}

interface Props {
  docs: DocItem[];
  currentId?: string;
}

const { docs, currentId } = Astro.props;

const categories = new Map<string, Map<string, DocItem[]>>();

for (const doc of docs) {
  const groups = categories.get(doc.category) ?? new Map<string, DocItem[]>();
  categories.set(doc.category, groups);

  const group = doc.group || '';
  const items = groups.get(group) ?? [];
  items.push(doc);
  groups.set(group, items);
}

for (const groups of categories.values()) {
  for (const items of groups.values()) {
    items.sort((a, b) => a.order - b.order);
  }
}
---

<nav id="docs-sidebar" class="docs-sidebar" data-docs-sidebar aria-label="文档目录">
  <button class="docs-sidebar-close" data-docs-sidebar-close type="button" aria-label="关闭目录">
    关闭 ×
  </button>

  {[...categories.entries()].map(([category, groups]) => {
    const categoryDocs = [...groups.values()].flat();
    const isCurrent = categoryDocs.some((doc) => doc.id === currentId);

    return (
      <details class="docs-category" open={isCurrent}>
        <summary>{category}</summary>

        {[...groups.entries()].map(([group, items]) => (
          <div class="sidebar-group">
            {group && <div class="sidebar-label">{group}</div>}
            {items.map((doc) => (
              <a
                href={`/docs/${doc.id}/`}
                class:list={['sidebar-link', { active: doc.id === currentId }]}
                aria-current={doc.id === currentId ? 'page' : undefined}
              >
                {doc.title}
              </a>
            ))}
          </div>
        ))}
      </details>
    );
  })}
</nav>
